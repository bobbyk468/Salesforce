# Public site URL — must match the hostname users land on after redirects (this project 301s
# trailblazeprep.com → www). Use www in production or sitemap.xml will list redirect-only URLs.
# NEXT_PUBLIC_SITE_URL=https://www.trailblazeprep.com

# Optional: Resend API key for sending contact form emails to km.krishnamohan25@gmail.com
# Get a key at https://resend.com
# RESEND_API_KEY=re_xxxxx

# Optional: Bing Webmaster API key for URL Submission (faster Bing indexing)
# Get from: Bing Webmaster Tools > Settings > API Access > Generate
# BING_INDEXING_API_KEY=your_api_key

# X (Twitter) API credentials for automated posting
# Get from: https://developer.x.com/en/portal/dashboard
# Required permissions: Read + Write (OAuth 1.0a)
# X_API_KEY=your_api_key
# X_API_SECRET=your_api_secret
# X_ACCESS_TOKEN=your_access_token
# X_ACCESS_TOKEN_SECRET=your_access_token_secret
