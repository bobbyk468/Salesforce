/.next/
/.open-next/
/out/

# Production
/build

# Misc
.DS_Store
*.pem

# Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Local env files (API keys: use env only, never commit)
.env*.local
.env

# Local mutex for post-to-x.mjs (schedule/post)
scripts/.x-posting.lock

# PageSpeed audit results (regenerated; do not commit)
scripts/psi_results_trailblaze.json

# Vercel
.vercel

# TypeScript
*.tsbuildinfo
next-env.d.ts

# IDE
.idea
.vscode
# Google Indexing API tokens (never commit)
indexing_token_p*.json
tbprep_gsc_inspect*.py
tbprep_gsc_inspection.json
# Local GSC OAuth client + refresh token (never commit)
scripts/.gsc/
tbprep_indexed.txt
tbprep_pending.txt
submit_google_indexing.py
pending_indexing_urls.txt

# Python cache
__pycache__/
*.pyc
*.pyo
/.venv-seo/

# Tweet images (generated locally; large binary assets not for git)
scripts/tweet-images/

# GSC/Analytics exports (local data snapshots)
performance-report/

# Temporary data files
scripts/sample_pii_data/

# Imported question banks are generated locally by scripts/import-git-questions.mjs
# from a private source repo and are not redistributed here. Only empty placeholders
# are tracked, so a clean clone builds and pages fall back to their own questions.
src/lib/question-banks/imported/*
!src/lib/question-banks/imported/banks.json
!src/lib/question-banks/imported/counts.json
src/lib/question-banks/local/
