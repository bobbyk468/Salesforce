{
  "name": "salesforce-certifications",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "perf:check": "python3 scripts/page_speed_monitor.py",
    "validate:seo": "node scripts/validate-technical-seo.mjs",
    "validate:seo:local": "npm run build && node scripts/validate-technical-seo.mjs --base=http://localhost:3000",
    "validate:readability": "node scripts/validate-readability.mjs",
    "validate:perf": "node scripts/validate-performance.mjs",
    "validate:all": "node scripts/validate-technical-seo.mjs && node scripts/validate-readability.mjs",
    "indexnow": "node scripts/submit-indexnow.mjs",
    "bing:submit": "node scripts/submit-bing-urls.mjs",
    "verify:ahref": "node scripts/verify-ahref-fixes.mjs",
    "verify:gsc": "node scripts/verify-gsc-canonicals.mjs",
    "verify:article-schema": "node scripts/verify-article-schema.mjs",
    "fix:exam-tips-canonicals": "node scripts/fix-exam-tips-canonicals.mjs",
    "x:list": "node scripts/post-to-x.mjs list",
    "x:post": "node scripts/post-to-x.mjs post",
    "x:schedule": "node scripts/post-to-x.mjs schedule",
    "x:tip": "node scripts/post-to-x.mjs tip",
    "x:tip:standalone": "node scripts/post-to-x.mjs tip --standalone",
    "x:engage": "node scripts/post-to-x.mjs engage",
    "x:images": "node scripts/generate-tweet-images.mjs",
    "x:images:tips": "node scripts/generate-tweet-images.mjs --tips-only",
    "x:images:tips:missing": "node scripts/generate-tweet-images.mjs --tips-only --missing-only",
    "x:humanize": "node scripts/refresh-x-upcoming.mjs --all-threads --all-tips",
    "x:refresh-pending": "node scripts/refresh-x-upcoming.mjs",
    "x:analyze": "node scripts/analyze-x-queue.mjs",
    "cert:migration": "node scripts/cert-migration-status.mjs",
    "cert:bulk-legacy": "node scripts/bulk-migrate-cert-legacy-bodies.mjs",
    "cert:promote-associate": "node scripts/promote-all-certs-to-associate.mjs"
  },
  "dependencies": {
    "@next/third-parties": "^16.2.3",
    "critters": "0.0.23",
    "html-to-image": "^1.11.13",
    "lucide-react": "^0.400.0",
    "next": "^14.2.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.0",
    "postcss": "^8.4.0",
    "puppeteer": "^24.40.0",
    "tailwindcss": "^3.4.0",
    "twitter-api-v2": "^1.29.0",
    "typescript": "^5.4.0"
  }
}
