{
  "name": "salesforce-certifications",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "perf:check": "python3 scripts/page_speed_monitor.py",
    "validate:seo": "node scripts/validate-technical-seo.mjs",
    "validate:seo:local": "npm run build && node scripts/validate-technical-seo.mjs --base=http://localhost:3000",
    "validate:readability": "node scripts/validate-readability.mjs",
    "validate:perf": "node scripts/validate-performance.mjs",
    "validate:all": "node scripts/validate-technical-seo.mjs && node scripts/validate-readability.mjs"
  },
  "dependencies": {
    "next": "^14.2.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "lucide-react": "^0.400.0"
  },
  "browserslist": [
    "last 2 Chrome versions",
    "last 2 Firefox versions",
    "last 2 Safari versions",
    "last 2 Edge versions",
    "> 0.3%",
    "not dead",
    "not ie 11",
    "not op_mini all"
  ],
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "typescript": "^5.4.0",
    "autoprefixer": "^10.4.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0"
  }
}