{
  "name": "salesforce-certifications",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "perf:check": "python3 scripts/page_speed_monitor.py",
    "validate:seo": "node scripts/validate-technical-seo.mjs",
    "validate:seo:local": "npm run build && node scripts/validate-technical-seo.mjs --base=http://localhost:3000",
    "validate:readability": "node scripts/validate-readability.mjs",
    "validate:perf": "node scripts/validate-performance.mjs",
    "validate:all": "node scripts/validate-technical-seo.mjs && node scripts/validate-readability.mjs",
    "indexnow": "node scripts/submit-indexnow.mjs",
    "bing:submit": "node scripts/submit-bing-urls.mjs",
    "verify:ahref": "node scripts/verify-ahref-fixes.mjs",
    "verify:gsc": "node scripts/verify-gsc-canonicals.mjs",
    "verify:article-schema": "node scripts/verify-article-schema.mjs",
    "fix:exam-tips-canonicals": "node scripts/fix-exam-tips-canonicals.mjs"
  },
  "dependencies": {
    "next": "^14.2.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "lucide-react": "^0.400.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "typescript": "^5.4.0",
    "autoprefixer": "^10.4.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0"
  }
}