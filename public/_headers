/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# HTML is statically generated at build time, so it can sit in Cloudflare's
# edge cache and be revalidated in the background. Without this the worker
# runs on every request and cold TTFB measured 0.9-1.8s.
/*
  Cache-Control: public, max-age=0, s-maxage=86400, stale-while-revalidate=604800
