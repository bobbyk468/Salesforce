{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "trailblaze-prep",
  "main": "worker.mjs",
  "compatibility_date": "2026-09-17",
  "compatibility_flags": ["nodejs_compat"],
  "version_metadata": {
    "binding": "WORKER_VERSION"
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "observability": {
    "enabled": true
  }
}
